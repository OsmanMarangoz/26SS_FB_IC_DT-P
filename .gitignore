# Ignore everything by default
/*
/.*

# Keep only the folders we actually want in git
!/ros2_ws/
!/lerobot_ws/
!.gitignore
!README.md

# Ignore build and cache junk inside tracked workspaces
**/build/
**/install/
**/log/
**/__pycache__/
**/.venv/
**/*.egg-info/
**/*.pyc

# Exclude the analysis repo completely
DigitalTwin-LabRobot_ReposForAnalysis/

# Optional project-specific excludes
Documentary/
Documentary.zip
*.avi
*.pdf
*.odt
dokumente/
wifi/
models/

# Claude local memory
.claude/

# OS
.DS_Store
Thumbs.db
